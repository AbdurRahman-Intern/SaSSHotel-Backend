# =============================================================================
# .env.example  ->  copy this file to ".env" and edit the values.
#
#   cp .env.example .env
#   php artisan key:generate      (fills APP_KEY for you)
#
# ".env" holds SECRETS and per-machine settings. NEVER commit ".env" to Git.
# Only ".env.example" (this file, without real secrets) is committed.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="Hotel SaaS API"
APP_ENV=local                 # local | production. "local" shows detailed errors.
APP_KEY=                      # filled by: php artisan key:generate
APP_DEBUG=true                # MUST be false in production (it would leak code/secrets).
APP_URL=http://localhost:8000 # where this API runs (php artisan serve uses port 8000)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ---- Frontend (React) -------------------------------------------------------
# Browsers only allow the React app to call this API if its address is listed here (CORS).
# Several origins can be separated with commas. See config/cors.php.
FRONTEND_URL=http://localhost:5173

# ---- Database (MySQL) -------------------------------------------------------
# 1. Install MySQL (or XAMPP / Laragon / Docker).
# 2. Create an empty database:   CREATE DATABASE hotel_saas CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 3. Put your MySQL user and password below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_saas
DB_USERNAME=root
DB_PASSWORD=

# ---- Drivers (keep simple while learning) -----------------------------------
# "database" drivers store data in MySQL tables created by the default migrations.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Passwords --------------------------------------------------------------
BCRYPT_ROUNDS=12

# ---- Demo data --------------------------------------------------------------
# Password given to every demo account created by `php artisan db:seed`.
# Used ONLY by database/seeders. Never use a shared password like this in production.
DEMO_PASSWORD=Demo@123456

# ---- Mail (TODO) ------------------------------------------------------------
# New hotel owners should receive an invitation e-mail. Until you configure mail, messages are
# written to storage/logs/laravel.log instead of being sent.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@hotelsaas.test"
MAIL_FROM_NAME="${APP_NAME}"
